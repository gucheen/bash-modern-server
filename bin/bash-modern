#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

CONFIG_DIR="${BASH_MODERN_HOME:-${HOME}/.config/bash-modern}"
BACKUP_ROOT="${BASH_MODERN_BACKUP_ROOT:-${HOME}/.local/state/bash-modern/backups}"
BASHRC_FILE="${BASH_MODERN_BASHRC:-${HOME}/.bashrc}"
BEGIN_MARKER="# >>> bash-modern-server >>>"
END_MARKER="# <<< bash-modern-server <<<"

info() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

safe_paths() {
    [[ -n "${HOME:-}" && "${HOME}" != "/" ]] || die "HOME is unsafe or empty"
    [[ -n "${CONFIG_DIR}" && "${CONFIG_DIR}" != "/" && "${CONFIG_DIR}" != "${HOME}" ]] || die "unsafe config path"
    [[ -n "${BACKUP_ROOT}" && "${BACKUP_ROOT}" != "/" && "${BACKUP_ROOT}" != "${HOME}" ]] || die "unsafe backup path"
}

backup_state() {
    safe_paths
    local stamp backup
    stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    backup="${BACKUP_ROOT}/${stamp}"
    mkdir -p "${backup}"
    if [[ -f "${BASHRC_FILE}" ]]; then
        cp -p "${BASHRC_FILE}" "${backup}/bashrc"
        printf '1\n' >"${backup}/bashrc.present"
    else
        printf '0\n' >"${backup}/bashrc.present"
    fi
    if [[ -d "${CONFIG_DIR}" ]]; then
        cp -a "${CONFIG_DIR}" "${backup}/config"
        printf '1\n' >"${backup}/config.present"
    else
        printf '0\n' >"${backup}/config.present"
    fi
    printf '%s\n' "${backup}"
}

doctor() {
    local failed=0 autosuggestions_version starship_path
    printf '%-16s %s\n' "item" "status"
    printf '%-16s %s\n' "----" "------"
    if [[ -r "${CONFIG_DIR}/bashrc" ]]; then
        printf '%-16s %s\n' "configuration" "ok"
    else
        printf '%-16s %s\n' "configuration" "missing"
        failed=1
    fi
    if [[ -f "${BASHRC_FILE}" ]] && grep -Fq "${BEGIN_MARKER}" "${BASHRC_FILE}" && grep -Fq "${END_MARKER}" "${BASHRC_FILE}"; then
        printf '%-16s %s\n' ".bashrc loader" "ok"
    else
        printf '%-16s %s\n' ".bashrc loader" "missing"
        failed=1
    fi
    PATH="${CONFIG_DIR}/bin:${CONFIG_DIR}/vendor/fzf/bin:${PATH}"
    starship_path=$(type -P starship 2>/dev/null || true)
    if [[ -f "${CONFIG_DIR}/user/starship.enabled" && -x ${starship_path} ]]; then
        printf '%-16s %s\n' "prompt" "Starship (${starship_path})"
    elif [[ -f "${CONFIG_DIR}/user/starship.enabled" ]]; then
        printf '%-16s %s\n' "prompt" "native Bash (Starship missing)"
    else
        printf '%-16s %s\n' "prompt" "native Bash"
    fi
    if [[ -f "${CONFIG_DIR}/user/git-status.enabled" ]]; then
        printf '%-16s %s\n' "Git status" "enabled"
    else
        printf '%-16s %s\n' "Git status" "disabled"
    fi
    autosuggestions_version=
    if [[ -r "${CONFIG_DIR}/vendor/bash-autosuggestions/.bash-version" ]]; then
        autosuggestions_version=$(<"${CONFIG_DIR}/vendor/bash-autosuggestions/.bash-version")
    fi
    if [[ ${autosuggestions_version} == "${BASH_VERSION}" &&
          -r "${CONFIG_DIR}/vendor/bash-autosuggestions/bash-autosuggestions.bash" &&
          -f "${CONFIG_DIR}/vendor/bash-autosuggestions/bash-autosuggestions.so" ]]; then
        printf '%-16s %s\n' "autosuggestions" "ok"
    elif [[ -n ${autosuggestions_version} ]]; then
        printf '%-16s %s\n' "autosuggestions" "rebuild required (${autosuggestions_version})"
    else
        printf '%-16s %s\n' "autosuggestions" "missing"
    fi
    local tool
    for tool in bash fzf zoxide starship eza bat batcat fd fdfind rg; do
        if command -v "${tool}" >/dev/null 2>&1; then
            printf '%-16s %s\n' "${tool}" "$(command -v "${tool}")"
        fi
    done
    return "${failed}"
}

list_backups() {
    [[ -d "${BACKUP_ROOT}" ]] || { info "No backups"; return; }
    find "${BACKUP_ROOT}" -mindepth 1 -maxdepth 1 -type d -print | LC_ALL=C sort
}

rollback() {
    safe_paths
    local target="${1:-}"
    if [[ -z "${target}" ]]; then
        target="$(list_backups | tail -n 1)"
    elif [[ "${target}" != /* ]]; then
        target="${BACKUP_ROOT}/${target}"
    fi
    [[ -d "${target}" ]] || die "backup not found: ${target}"
    [[ -f "${target}/bashrc.present" && -f "${target}/config.present" ]] || die "invalid backup: ${target}"

    local safety
    safety="$(backup_state)"
    info "Current state saved to ${safety}"

    if [[ "$(cat "${target}/bashrc.present")" == 1 ]]; then
        cp -p "${target}/bashrc" "${BASHRC_FILE}"
    else
        rm -f "${BASHRC_FILE}"
    fi
    rm -rf "${CONFIG_DIR}"
    if [[ "$(cat "${target}/config.present")" == 1 ]]; then
        cp -a "${target}/config" "${CONFIG_DIR}"
    fi
    info "Restored ${target}"
}

install_optional() {
    apt_install eza bat fd-find ripgrep
}

install_build_deps() {
    apt_install build-essential bash-builtins libreadline-dev pkg-config
}

apt_install() {
    [[ "$(uname -s)" == Linux ]] || die "package installation supports Debian/Ubuntu only"
    command -v apt-get >/dev/null 2>&1 || die "apt-get not found"
    local elevate=()
    if [[ ${EUID} -ne 0 ]]; then
        command -v sudo >/dev/null 2>&1 || die "sudo is required for apt packages; core installation does not require it"
        elevate=(sudo)
    fi
    "${elevate[@]}" apt-get update
    local packages=() package
    for package in "$@"; do
        if apt-cache show "${package}" >/dev/null 2>&1; then
            packages+=("${package}")
        else
            printf 'skip: %s is not available in configured repositories\n' "${package}"
        fi
    done
    ((${#packages[@]})) && "${elevate[@]}" apt-get install -y "${packages[@]}"
}

usage() {
    cat <<'EOF'
Usage: bash-modern COMMAND [arguments]

Commands:
  doctor                  Show installed integrations.
  backup                  Back up .bashrc and this environment.
  backups                 List available backups.
  rollback [name|path]    Restore a backup (latest when omitted).
  install-optional        Install eza, bat, fd and ripgrep via apt.
  install-build-deps      Install autosuggestions build dependencies via apt.
EOF
}

case "${1:-}" in
    doctor) doctor ;;
    backup) backup_state ;;
    backups) list_backups ;;
    rollback) rollback "${2:-}" ;;
    install-optional) install_optional ;;
    install-build-deps) install_build_deps ;;
    -h|--help|help|'') usage ;;
    *) die "unknown command: $1" ;;
esac
